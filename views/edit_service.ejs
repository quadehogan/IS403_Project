<%
  const errHtml = errorMessage
    ? `<div class="alert alert-danger">${errorMessage}</div>`
    : '';

  const body = `
    <div class="col-md-6 mx-auto mt-4">
      <h2 class="text-center mb-4">Edit Service</h2>
      ${errHtml}

      <form action="/edit_service/${service.Service_ID}" method="POST">
        <div class="mb-3">
          <label>Service Title</label>
          <input 
            type="text" 
            class="form-control" 
            name="S_Title" 
            value="${service.S_Title}" 
            required>
        </div>

        <div class="mb-3">
          <label>Description</label>
          <textarea 
            class="form-control" 
            name="S_Description" 
            rows="3" 
            required>${service.S_Description}</textarea>
        </div>

        <div class="mb-3">
          <label>Price</label>
          <input 
            type="number" 
            step="0.01" 
            class="form-control" 
            name="S_Price" 
            value="${service.S_Price}" 
            required>
        </div>

        <button type="submit" class="btn btn-primary w-100">Save Changes</button>
      </form>

      <p class="text-center mt-3"><a href="/services">Back to Services</a></p>
    </div>
  `;
%>

<%- include('layout', { title: 'Edit Service', body }) %>
