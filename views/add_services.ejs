<%
  const errHtml = errorMessage
    ? `<div class="alert alert-danger">${errorMessage}</div>`
    : '';

  const body = `
    <div class="col-md-6 mx-auto mt-4">
      <h2 class="text-center mb-4">Add New Service</h2>
      ${errHtml}
      <form action="/business-submit-service" method="POST">
        <div class="mb-3">
          <label>Service Title</label>
          <input type="text" class="form-control" name="S_Title" required>
        </div>
        <div class="mb-3">
          <label>Description</label>
          <textarea class="form-control" name="S_Description" rows="3" required></textarea>
        </div>
        <div class="mb-3">
          <label>Price</label>
          <input type="number" step="0.01" class="form-control" name="S_Price" required>
        </div>
        <button type="submit" class="btn btn-success w-100">Add Service</button>
      </form>
      <p class="text-center mt-3"><a href="/services">Back to Services</a></p>
    </div>
  `;
%>

<%- include('layout', { title: 'Add Service', body }) %>
