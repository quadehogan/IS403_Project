<%- include('layout', {
  title: 'Services',
  body: `
  <div class="col-md-10 mx-auto mt-4">
    <h2 class="text-center mb-4">Services</h2>

    ${errorMessage ? `<div class="alert alert-danger">${errorMessage}</div>` : ''}

    <table class="table table-striped table-bordered">
      <thead class="table-dark">
        <tr>
          <th>Business Name</th>
          <th>Title</th>
          <th>Description</th>
          <th>Price</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        ${
          services.length === 0
            ? '<tr><td colspan="5" class="text-center">No services available</td></tr>'
            : services.map(service => {
                const actions =
                  accountType === 'business' && accountInfo.Business_ID === service.Business_ID
                    ? `
                      <div class="d-flex gap-2 justify-content-center">
                        <a href="/edit_service/${service.Service_ID}" class="btn btn-sm btn-primary">Edit</a>
                        <form action="/delete_service/${service.Service_ID}" method="POST" style="margin:0;">
                          <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                      </div>
                    `
                    : '';
                return `
                  <tr>
                    <td>${service.B_Name}</td>
                    <td>${service.S_Title}</td>
                    <td>${service.S_Description}</td>
                    <td>$${Number(service.S_Price).toFixed(2)}</td>
                    <td>${actions}</td>
                  </tr>
                `;
              }).join('')
        }
      </tbody>
    </table>

    ${
      accountType === 'business'
        ? '<div class="text-center mt-3"><a href="/add_services" class="btn btn-success">Add Service</a></div>'
        : ''
    }
  </div>
  `
}) %>




